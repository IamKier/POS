rules_version = '2';

/**
 * HOW TO APPLY, in this order. The order matters.
 *
 *   1. Firebase console > Authentication > Sign-in method > enable
 *      Email/Password.
 *   2. Open the app and create the owner account. It is the first
 *      account, so it becomes a manager. Do this BEFORE step 3, while
 *      test mode still allows the write.
 *   3. Firebase console > Firestore Database > Rules, paste this file,
 *      Publish.
 *
 * Roles live in users/{uid}.role rather than in a custom auth claim,
 * because claims can only be set by the Admin SDK, which needs a server
 * and the paid plan. The rules below read that document, and only a
 * manager can write to users, so a cashier cannot promote themselves.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /* Someone who has left still knows their code and PIN, so every
       write is checked against the account still being active. */
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active != false;
    }

    function isManager() {
      return isActive() && profile().role == 'manager';
    }

    /**
     * Staff records. Everyone signed in can read the list, because the
     * till shows who rang up a sale. Only a manager writes them, which
     * is what stops a cashier editing their own role.
     */
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    /**
     * A manager owns the catalog. A cashier may change one field on it,
     * the stock count, because that is what a sale does. Anything else
     * on the product, price included, is rejected for them.
     */
    match /products/{productId} {
      allow read: if signedIn();
      allow create, delete: if isManager();
      allow update: if isManager()
        || (isActive()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['stock']));
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    // Money settings, tax rate, receipt header.
    match /config/{document} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    /**
     * Sales are append-only on purpose. A cashier rings one up, a void
     * writes a status on top, and nothing removes the record. That is
     * the difference between a sales history and an audit trail, and it
     * is the first thing an accountant asks for.
     */
    match /sales/{saleId} {
      allow read: if signedIn();
      allow create: if isActive();
      allow update: if isActive();
      allow delete: if false;
    }

    // Stock movements are the same: written, never rewritten.
    match /stockMoves/{moveId} {
      allow read: if signedIn();
      allow create: if isActive();
      allow update, delete: if false;
    }

    /**
     * A shift is opened by the cashier standing at the register and
     * closed with a counted drawer. Like sales, it is never deleted:
     * a shift with a shortfall is exactly the record someone will want
     * to look at later.
     */
    match /shifts/{shiftId} {
      allow read: if signedIn();
      allow create, update: if isActive();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
