# Firebase web config, from Project settings > Your apps > SDK setup.
# These are publishable values: every Firebase web app ships them in the
# browser bundle. Firestore security rules are the access boundary, not
# this file. Leave them unset and the app runs on localStorage alone.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
